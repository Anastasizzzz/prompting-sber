# Ключ авторизации GigaChat (Authorization key из личного кабинета, base64 "client_id:secret").
# Положите настоящий ключ в .env в корне репозитория или в agent/.env. Файл .env не коммитится.
GIGACHAT_CREDENTIALS=
# Тип доступа: GIGACHAT_API_B2B (юрлицо, пакеты), GIGACHAT_API_CORP (юрлицо, оплата по факту), GIGACHAT_API_PERS (физлицо)
GIGACHAT_SCOPE=GIGACHAT_API_B2B
# Учебный обход цепочки сертификатов российских УЦ; 1 - проверять TLS
GIGACHAT_VERIFY_SSL=0
# GIGACHAT_MODEL=GigaChat-2-Max
